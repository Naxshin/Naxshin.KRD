{
  "appId": "krd.naxshin.app",
  "appName": "Naxshin",
  "webDir": "www",
  "loggingBehavior": "none",
  "server": {
    "androidScheme": "https",
    "hostname": "naxshin.github.io"
  },
  "android": {
    "backgroundColor": "#F3ECE0",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#F3ECE0",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  },
  "ios": {
    "backgroundColor": "#F3ECE0",
    "contentInset": "never",
    "scrollEnabled": true,
    "allowsLinkPreview": false
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          }
        },
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}
